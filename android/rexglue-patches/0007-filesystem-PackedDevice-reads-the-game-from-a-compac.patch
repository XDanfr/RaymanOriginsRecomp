diff --git a/src/filesystem/devices/packed_device.cpp b/src/filesystem/devices/packed_device.cpp
new file mode 100644
index 0000000..48416f1
--- /dev/null
+++ b/src/filesystem/devices/packed_device.cpp
@@ -0,0 +1,186 @@
+/**
+ * @file        filesystem/devices/packed_device.cpp
+ * @brief       Read-only device serving a game folder from a deduplicated pack
+ */
+
+#include <rex/filesystem/devices/packed_device.h>
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/string/utf8.h>
+
+namespace rex::filesystem {
+
+namespace {
+constexpr size_t kHeaderSize = 48;
+constexpr uint64_t kTimestamp = 10000 * 11644473600000LL;
+
+template <typename T>
+T Get(const uint8_t* p) {
+  T v;
+  std::memcpy(&v, p, sizeof(T));  // the pack is little-endian, as are the hosts
+  return v;
+}
+}  // namespace
+
+// ---- Device ----
+
+PackedDevice::PackedDevice(const std::string_view mount_path, const std::filesystem::path& host_path)
+    : Device(mount_path), name_("RDPK"), host_path_(host_path) {}
+
+PackedDevice::~PackedDevice() = default;
+
+bool PackedDevice::IsPack(const std::filesystem::path& path) {
+  std::ifstream f(path, std::ios::binary);
+  char magic[4] = {};
+  return f.read(magic, 4) && std::memcmp(magic, "RDPK", 4) == 0;
+}
+
+bool PackedDevice::Initialize() {
+  mmap_ = memory::MappedMemory::Open(host_path_, memory::MappedMemory::Mode::kRead);
+  if (!mmap_ || mmap_->size() < kHeaderSize || std::memcmp(mmap_->data(), "RDPK", 4) != 0) {
+    REXFS_ERROR("Game pack {} could not be mapped or is not an RDPK pack", host_path_.string());
+    return false;
+  }
+  const uint8_t* base = mmap_->data();
+  const size_t size = mmap_->size();
+  uint32_t version = Get<uint32_t>(base + 4), count = Get<uint32_t>(base + 8);
+  uint64_t table_offset = Get<uint64_t>(base + 16), table_size = Get<uint64_t>(base + 24);
+  if (version != 1 || table_offset > size || table_size > size - table_offset) {
+    REXFS_ERROR("Game pack {}: unsupported version {} or damaged table", host_path_.string(), version);
+    return false;
+  }
+
+  auto root = std::make_unique<PackedEntry>(this, nullptr, "", mmap_.get());
+  root->attributes_ = kFileAttributeDirectory;
+  const uint8_t* p = base + table_offset;
+  const uint8_t* end = p + table_size;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (end - p < 2) return false;
+    uint16_t name_length = Get<uint16_t>(p);
+    p += 2;
+    if (end - p < name_length + 12) return false;
+    std::string_view rel(reinterpret_cast<const char*>(p), name_length);
+    p += name_length;
+    uint64_t file_size = Get<uint64_t>(p);
+    uint32_t extent_count = Get<uint32_t>(p + 8);
+    p += 12;
+    if (uint64_t(end - p) < uint64_t(extent_count) * 24) return false;
+
+    // Directories along the path, created as needed.
+    Entry* parent = root.get();
+    auto parts = rex::string::utf8_split_path(rel);
+    if (parts.empty()) {
+      p += size_t(extent_count) * 24;
+      continue;
+    }
+    for (size_t c = 0; c + 1 < parts.size(); ++c) {
+      Entry* dir = parent->GetChild(parts[c]);
+      if (!dir) {
+        auto made = std::make_unique<PackedEntry>(this, parent,
+                                                  rex::string::utf8_join_guest_paths(parent->path(), parts[c]),
+                                                  mmap_.get());
+        made->attributes_ = kFileAttributeDirectory;
+        made->create_timestamp_ = made->access_timestamp_ = made->write_timestamp_ = kTimestamp;
+        dir = made.get();
+        static_cast<PackedEntry*>(parent)->children_.emplace_back(std::move(made));
+      }
+      parent = dir;
+    }
+
+    auto file = std::make_unique<PackedEntry>(this, parent,
+                                              rex::string::utf8_join_guest_paths(parent->path(), parts.back()),
+                                              mmap_.get());
+    file->attributes_ = kFileAttributeReadOnly;
+    file->size_ = file_size;
+    file->allocation_size_ = rex::round_up(file_size, uint64_t(bytes_per_sector()));
+    file->create_timestamp_ = file->access_timestamp_ = file->write_timestamp_ = kTimestamp;
+    file->extents_.reserve(extent_count);
+    uint64_t covered = 0;
+    for (uint32_t e = 0; e < extent_count; ++e, p += 24) {
+      PackedEntry::Extent x{Get<uint64_t>(p), Get<uint64_t>(p + 8), Get<uint64_t>(p + 16)};
+      if (x.file_offset != covered || x.pack_offset > size || x.length > size - x.pack_offset) {
+        REXFS_ERROR("Game pack {}: damaged extents for {}", host_path_.string(), rel);
+        return false;
+      }
+      covered += x.length;
+      file->extents_.push_back(x);
+    }
+    if (covered != file_size) {
+      REXFS_ERROR("Game pack {}: extents of {} cover {} of {} bytes", host_path_.string(), rel, covered, file_size);
+      return false;
+    }
+    total_size_ += file_size;
+    ++file_count_;
+    static_cast<PackedEntry*>(parent)->children_.emplace_back(std::move(file));
+  }
+  root_entry_ = std::move(root);
+  REXFS_INFO("Game pack {}: {} files, {} bytes served from {} bytes", host_path_.string(), file_count_,
+             total_size_, size);
+  return true;
+}
+
+void PackedDevice::Dump(string::StringBuffer* string_buffer) {
+  auto global_lock = global_critical_region_.Acquire();
+  string_buffer->AppendFormat("{}: {} files, {} bytes from pack {}\n", mount_path(), file_count_, total_size_,
+                              host_path_.string());
+}
+
+Entry* PackedDevice::ResolvePath(const std::string_view path) { return root_entry_->ResolvePath(path); }
+
+// ---- Entry ----
+
+PackedEntry::PackedEntry(Device* device, Entry* parent, const std::string_view path, memory::MappedMemory* mmap)
+    : Entry(device, parent, path), mmap_(mmap) {}
+
+PackedEntry::~PackedEntry() = default;
+
+X_STATUS PackedEntry::Open(uint32_t desired_access, File** out_file) {
+  *out_file = new PackedFile(desired_access, this);
+  return X_STATUS_SUCCESS;
+}
+
+std::unique_ptr<memory::MappedMemory> PackedEntry::OpenMapped(memory::MappedMemory::Mode mode, size_t offset,
+                                                             size_t length) {
+  if (mode != memory::MappedMemory::Mode::kRead || extents_.size() != 1 || offset > size_) {
+    return nullptr;
+  }
+  size_t real_length = length ? std::min<size_t>(length, size_ - offset) : size_ - offset;
+  return mmap_->Slice(extents_[0].pack_offset + offset, real_length);
+}
+
+// ---- File ----
+
+PackedFile::PackedFile(uint32_t file_access, PackedEntry* entry) : File(file_access, entry), entry_(entry) {}
+
+PackedFile::~PackedFile() = default;
+
+void PackedFile::Destroy() { delete this; }
+
+X_STATUS PackedFile::ReadSync(std::span<uint8_t> buffer, size_t byte_offset, size_t* out_bytes_read) {
+  if (byte_offset >= entry_->size()) {
+    return X_STATUS_END_OF_FILE;
+  }
+  const auto& extents = entry_->extents();
+  // First extent that ends after byte_offset.
+  auto it = std::upper_bound(extents.begin(), extents.end(), uint64_t(byte_offset),
+                             [](uint64_t off, const PackedEntry::Extent& e) { return off < e.file_offset + e.length; });
+  const uint8_t* base = entry_->mmap()->data();
+  size_t done = 0, want = std::min<size_t>(buffer.size(), entry_->size() - byte_offset);
+  size_t pos = byte_offset;
+  for (; it != extents.end() && done < want; ++it) {
+    size_t inside = pos - it->file_offset;
+    size_t n = std::min<size_t>(it->length - inside, want - done);
+    std::memcpy(buffer.data() + done, base + it->pack_offset + inside, n);
+    done += n;
+    pos += n;
+  }
+  *out_bytes_read = done;
+  return X_STATUS_SUCCESS;
+}
+
+}  // namespace rex::filesystem
