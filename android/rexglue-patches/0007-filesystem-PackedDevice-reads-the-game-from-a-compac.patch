   if (!device->Initialize()) {
-    REXSYS_ERROR("Runtime::SetupVfs: Failed to initialize host path device");
+    REXSYS_ERROR("Runtime::SetupVfs: Failed to initialize the game device");
     return false;
   }
   if (!file_system_->RegisterDevice(std::move(device))) {
